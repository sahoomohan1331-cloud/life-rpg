# Database (Neon PostgreSQL for production, or SQLite file:./dev.db for local)
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Auth.js
AUTH_SECRET="generate-a-random-32-char-string-here"
AUTH_URL="http://localhost:3000"

# Optional: Real SMTP Email Delivery (Gmail, Resend, SendGrid, Brevo, AWS SES)
# If omitted, Life RPG automatically falls back to an Ethereal test transport with web preview URLs.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-gmail-app-password"
EMAIL_FROM="\"Life RPG\" <noreply@liferpg.dev>"

# Optional
NODE_ENV="development"
